# Auto detect text files and perform LF normalization
* text=auto eol=lf

# PHP files always LF
*.php text eol=lf

# Shell scripts always LF
*.sh text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.md text eol=lf
*.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary

# Keep the dist tarball to the runtime surface: everything below is development-only
# and would otherwise ship into every consumer's vendor/ directory.
/.github            export-ignore
/.dev               export-ignore
/.idea              export-ignore
/tests              export-ignore
/docs               export-ignore
/examples           export-ignore
/benchmarks         export-ignore
/docker             export-ignore
/.env.example       export-ignore
/docker-compose.yml export-ignore
/phpunit.xml        export-ignore
/phpstan.neon.dist  export-ignore
/pint.json          export-ignore
/rector.php         export-ignore
/CONTRIBUTING.md    export-ignore
/CLAUDE.md          export-ignore
/tools              export-ignore
/CODE_OF_CONDUCT.md  export-ignore
