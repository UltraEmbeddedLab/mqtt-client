{
  "name": "ultraembeddedlab/php-iot",
  "description": "MQTT 3.1.1 and MQTT 5.0 client for PHP 8.4+ — QoS 0/1/2, TLS and mutual TLS, WebSocket transport, auto-reconnect, persistent sessions",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "mqtt", "mqtt-client", "mqtt5", "mqtt-5", "mqtt3", "mqtt-3.1.1",
    "iot", "pub-sub", "publish-subscribe", "message-broker", "broker",
    "mosquitto", "hivemq", "emqx", "aws-iot", "azure-iot",
    "websocket", "mtls", "qos", "telemetry", "home-assistant", "smart-home"
  ],
  "homepage": "https://github.com/UltraEmbeddedLab/php-iot",
  "authors": [
    {
      "name": "Bogdan Gewald",
      "email": "gewaldb@gmail.com",
      "homepage": "https://github.com/UltraEmbeddedLab",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/UltraEmbeddedLab/php-iot/issues",
    "source": "https://github.com/UltraEmbeddedLab/php-iot",
    "docs": "https://github.com/UltraEmbeddedLab/php-iot/tree/main/docs",
    "security": "https://github.com/UltraEmbeddedLab/php-iot/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "psr/log": "^3.0.2",
    "psr/event-dispatcher": "^1.0"
  },
  "suggest": {
    "ext-openssl": "Required for TLS/SSL connections (mqtts://, wss://). Plain TCP works without it."
  },
  "require-dev": {
    "laravel/pint": "^1.30.3",
    "pestphp/pest": "^5.0.2",
    "pestphp/pest-plugin-type-coverage": "^5.0.0",
    "phpstan/phpstan": "^2.2.7",
    "rector/rector": "^2.5.9",
    "symfony/var-dumper": "^8.1.2",
    "symfony/yaml": "^8.1.2",
    "vlucas/phpdotenv": "^5.6.4"
  },
  "autoload": {
    "psr-4": {
      "ScienceStories\\Mqtt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ScienceStories\\Mqtt\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "pest",
    "test:unit": "pest --testsuite=Unit",
    "test:integration": "pest --testsuite=Integration",
    "test:coverage": "pest --coverage",
    "type-coverage": "pest --type-coverage",
    "stan": "phpstan analyse --memory-limit=1G",
    "pint": "pint",
    "lint:workflows": "php tools/lint-workflows.php",
    "lint": "@pint --test && @stan && @lint:workflows",
    "rector": "rector process --clear-cache",
    "rector:check": "rector process --clear-cache --dry-run",
    "security:audit": "composer audit",
    "validate:strict": "composer validate --strict",
    "ci": "@validate:strict && @security:audit && @lint:workflows && @pint --test && @stan && @rector:check && @test",
    "bench": "php benchmarks/publish-throughput.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
