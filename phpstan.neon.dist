parameters:
  phpVersion: 80400
  level: max
  paths:
    - src
  bootstrapFiles:
    - vendor/autoload.php
  treatPhpDocTypesAsCertain: true
  # Dead suppressions are themselves a defect: they hide the moment a workaround stops
  # being needed. Keep this on so an unmatched ignore fails the build.
  reportUnmatchedIgnoredErrors: true
  checkMissingTypehints: true
  inferPrivatePropertyTypeFromConstructor: true
  parallel:
    maximumNumberOfProcesses: 8
