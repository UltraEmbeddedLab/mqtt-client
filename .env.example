# Broker configuration for the examples in examples/.
# Copy to .env and fill in. Do NOT commit real credentials — .env is gitignored.
#
# With no .env at all the examples fall back to examples/config.php.dist, which targets
# the Mosquitto in docker-compose.yml (`docker compose up -d`) on localhost:1883.

# --- Connection ---
MQTT_HOST=localhost
MQTT_SCHEME=tcp          # tcp | tls
MQTT_PORT=               # optional; defaults to 1883 for tcp, 8883 for tls

# --- Authentication (optional) ---
MQTT_USERNAME=
MQTT_PASSWORD=

# --- TLS (only read when MQTT_SCHEME=tls) ---
# Booleans accept true/false/1/0/yes/no. An unparseable value is an error, not a silent false.
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_ALLOW_SELF_SIGNED=false   # leave false unless you also set MQTT_TLS_CA_FILE
MQTT_TLS_CA_FILE=
MQTT_TLS_ALPN=                     # e.g. "mqtt" for MQTT over port 443

# --- Mutual TLS (client certificate) ---
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_TLS_CLIENT_KEY_PASSPHRASE=
